# Vikings League — variáveis de ambiente
#
# Copie para .env e preencha. NUNCA commite o .env real.
# Nenhuma variável aqui pode receber o prefixo NEXT_PUBLIC_, exceto as
# marcadas explicitamente como públicas — elas vão para o bundle do browser.

# ─────────────────────────────────────────────────────────────
# BANCO — Neon PostgreSQL
# ─────────────────────────────────────────────────────────────
# DATABASE_URL: conexão via pooler (PgBouncer). Usada em runtime.
# DIRECT_URL:   conexão direta, sem pooler. Usada por `prisma migrate`,
#               que precisa de prepared statements — o pooler não suporta.
# No Neon, a segunda corresponde à connection string "unpooled".
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require"

# ─────────────────────────────────────────────────────────────
# GATEWAY PIX — provider ainda não decidido
# ─────────────────────────────────────────────────────────────
# Use SEMPRE credenciais de sandbox fora de produção.
PAYMENT_PROVIDER="mock"
PAYMENT_ACCESS_TOKEN=""
PAYMENT_WEBHOOK_SECRET=""

# ─────────────────────────────────────────────────────────────
# AUTENTICAÇÃO ADMIN
# ─────────────────────────────────────────────────────────────
# AUTH_SECRET: gere com `npx auth secret` ou `openssl rand -base64 32`
AUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Allowlist de administradores, separados por vírgula.
# Autenticar não basta: o servidor confere o e-mail contra esta lista.
ADMIN_EMAILS="pedruamerico@gmail.com"

# ─────────────────────────────────────────────────────────────
# ANTI-ABUSO — Cloudflare Turnstile
# ─────────────────────────────────────────────────────────────
# A site key é pública por definição (renderiza o widget no browser).
# A secret key valida o token no servidor e NUNCA vai para o client.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# ─────────────────────────────────────────────────────────────
# APLICAÇÃO
# ─────────────────────────────────────────────────────────────
# URL absoluta do ambiente. O gateway usa para montar o callback do webhook.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Protege /api/cron/*, que expira reservas de vaga vencidas.
CRON_SECRET=""

# Link do grupo de WhatsApp. Entregue apenas server-side, para inscrição
# confirmada — por isso não leva NEXT_PUBLIC_.
WHATSAPP_GROUP_URL=""
